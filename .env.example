# ─── Server (.env in /server) ───
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend (Vite .env in project root) ───
# VITE_API_URL is the base URL for API calls in production.
# Leave empty for local dev (Vite proxy handles it).
# In production, set to your deployed backend URL, e.g.:
# VITE_API_URL=https://inisai-1-5.onrender.com
VITE_API_URL=
